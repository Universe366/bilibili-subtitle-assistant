{
  "name": "shizi",
  "version": "0.37.9",
  "private": true,
  "description": "B站字幕助手桌面端",
  "author": "bsub",
  "main": "./out/main/index.js",
  "scripts": {
    "sync:bridge": "node scripts/sync-bridge.mjs",
    "sync:extension": "node scripts/sync-extension.mjs",
    "predev": "npm run sync:bridge",
    "dev": "electron-vite dev",
    "prebuild": "npm run sync:bridge && npm run sync:extension",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" package.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm test",
    "verify": "npm run check && npm run smoke",
    "smoke": "node scripts/smoke.mjs",
    "dist": "npm run build && electron-builder --win",
    "dist:dir": "npm run build && electron-builder --win --dir",
    "pack": "npm run build && electron-builder --win --publish never --config.electronDist=node_modules/electron/dist",
    "release:notes": "node scripts/release.mjs"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "ffmpeg-static": "^5.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.9.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "lucide-react": "^1.61.0",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "build": {
    "appId": "com.shizi.desktop",
    "productName": "拾字",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": "."
      }
    ],
    "npmRebuild": false,
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "shizi-setup-${version}.${ext}",
      "shortcutName": "拾字",
      "include": "build/installer.nsh",
      "deleteAppDataOnUninstall": false,
      "installerLanguages": [
        "zh_CN",
        "en_US"
      ]
    },
    "asar": true,
    "publish": {
      "provider": "github",
      "owner": "Universe366",
      "repo": "shizi",
      "releaseType": "release"
    },
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ]
  }
}
