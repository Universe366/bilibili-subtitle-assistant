{
  "schema": 1,
  "general": {
    "theme": "system",
    "fontScale": 1,
    "layout": "auto",
    "autoFollow": true,
    "showInlineActions": "hover",
    "firstRun": true,
    "wizardDone": false,
    "lastTab": "subtitles"
  },
